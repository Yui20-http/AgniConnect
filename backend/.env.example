# ============================================================
# AgriConnect Backend - Environment Variables
# Copy this file to ".env" and fill in your own values.
#   cp .env.example .env
# ============================================================

# MongoDB connection string
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/agriconnect
# MongoDB Atlas (cloud) example:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/agriconnect

# Secret key used to sign JWT tokens. Use a long random string in production.
JWT_SECRET=agriconnect_super_secret_change_me_in_production_2024
JWT_EXPIRES_IN=7d

# Backend server port
PORT=5000

# Frontend URL (used for CORS)
CLIENT_URL=http://localhost:5173

# Default Admin account (created by the seed script)
ADMIN_NAME=AgriConnect Admin
ADMIN_EMAIL=admin@agriconnect.com
ADMIN_PHONE=9000000000
ADMIN_PASSWORD=Admin@123
