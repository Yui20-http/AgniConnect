# ============================================================
# AgriConnect Backend - Environment Variables
# Copy this file to ".env" and fill in your own values.
#   cp .env.example .env
# ============================================================

# MongoDB connection string
# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/agriconnect
# MongoDB Atlas (cloud) example:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/agriconnect

# Secret key used to sign JWT tokens. Use a long random string in production.
JWT_SECRET=agriconnect_super_secret_change_me_in_production_2024
JWT_EXPIRES_IN=7d

# Backend server port
PORT=5000

# Frontend URL (used for CORS)
CLIENT_URL=http://localhost:5173

# Product image storage (required in production; local uploads are used in development if unset)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP email delivery for verification and password reset
# Gmail: use a Google App Password in SMTP_PASS (not your normal password).
# Leave SMTP_FROM blank to send from SMTP_USER, or set a verified sender address.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Razorpay test/live keys (online checkout is disabled until both are configured)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# MSG91 transactional SMS (approved Flow template variables: VAR1 = OTP, VAR2 = order number)
MSG91_AUTH_KEY=
MSG91_DELIVERY_OTP_TEMPLATE_ID=

# Default Admin account (created by the seed script)
ADMIN_NAME=AgriConnect Admin
ADMIN_EMAIL=admin@agriconnect.com
ADMIN_PHONE=9000000000
ADMIN_PASSWORD=Admin@123
