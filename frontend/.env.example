# ============================================================
# AgriConnect Frontend - Environment Variables
# Copy this file to ".env" if you need to override defaults.
#   cp .env.example .env
# ============================================================

# Backend target used by the Vite dev-server proxy (default: http://localhost:5000)
VITE_API_TARGET=http://localhost:5000

# Optional: full API URL (leave unset to use the /api proxy)
# VITE_API_URL=http://localhost:5000/api

# Optional: Socket.IO server URL (leave unset to use the same origin + proxy)
# VITE_SOCKET_URL=http://localhost:5000
